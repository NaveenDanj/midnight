func matrixBenchmark() int {

    var int size = 200;

    var int i = 0;
    var int j = 0;
    var int k = 0;

    var int result = 0;


    while(i < size) {

        j = 0;

        while(j < size) {

            k = 0;

            while(k < size) {

                result = result + (i * j) + k;

                k = k + 1;
            }

            j = j + 1;
        }

        i = i + 1;
    }


    return result;
}


print(matrixBenchmark());