var int[10] arr = [];
var int index = 0;

while(index < 10) {

    if(index == 0) {
        arr[index] = 10;
    }else{
        arr[index] = index *100;
    }

    index = index + 1;
}

index = 0;

while(index < 10) {
    print(arr[index]);
    print("");
    index = index + 1;
}

struct Person {
    var string first_name;
    var string last_name;

    func greet() string {
        return "Hello, " + self.first_name + " " + self.last_name;
    }

}

var Person person1 = Person{
    first_name = "John",
    last_name = "Doe"
};


var Person person2 = Person{
    first_name = "Naveen",
    last_name = "Hettiwaththa"
};

print(person1.greet());
print(person2.greet());