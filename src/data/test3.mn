func factorial(int n) int {

    if(n == 0) {
        return 0;
    }
        
    if (n == 1) {
        return 1;
    }

    return n * factorial(n-1); 
}

func fib(int n) int {

    if(n == 0) {
        return 0;
    }
        
    if (n == 1) {
        return 1;
    }

    return fib(n-1) + fib(n-2);
}

func loop(int val) void {
    
    while(val > 0){
        print(val);
        print("");
        val = val - 1;
    }

}

var int val = factorial(10);
var int fib_val = fib(10); 

print("factorial : ");
print(val);
print("");

print("fibbonachi : ");
print(fib_val);
print("");

var int test2 = 100;
loop(test2);
print("");
print(test2);