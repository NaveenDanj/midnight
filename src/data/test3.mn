import "std.mn";

func is_prime(int n) bool {
    
    if (n < 2) {
        return false;
    }

    var int i = 2;

    while (i * i <= n) {

        if (n % i == 0) {
            return false;
        }

        i = i + 1;
    }

    return true;
}


func main() void {

    var int count = 0;

    var int n = 2;

    while (n <= 1000000) {

        if (is_prime(n)) {
            count = count + 1;
        }

        n = n + 1;
    }

}

main();

