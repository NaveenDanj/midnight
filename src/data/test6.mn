
struct Node {
    var int value;
    var Node next;
}

struct LinkedList {
    var Node head;

    func createNode(int val) Node {
        var Node node = Node {
            value = val,
            next = null
        };
        return node;
    }

    func appendNode(int val) void {
        var Node newNode = self.createNode(val);
        var Node current = self.head;
        while(current.next != null){
            current = current.next;
        }
        current.next = newNode;
    }

    func walk() void {
        var Node current = self.head;
        while(current.next != null){
            print(current.value);
            current = current.next;
        }
    }

}

var int[6] values = [1,2,3,4,5,6];
var int index = 1;

var LinkedList linkedList = LinkedList{
    head = Node{
        value = values[0],
        next = null
    }
}

while(index < 6) {
    linkedList.appendNode(values[index]);
    index += 1;
}

linkedList.walk();