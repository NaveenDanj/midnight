extern func midnight_file_read(string path) string;
extern func midnight_file_exists(string path) bool;
extern func midnight_file_write(string path, string buffer) bool;

struct File {
    
    func read(string path) string {
        return midnight_file_read(path);
    }

    func exists(string path) bool {
        return midnight_file_exists(path);
    }

    func write(string path, string buffer) bool{
        return midnight_file_write(path, buffer);
    }

}